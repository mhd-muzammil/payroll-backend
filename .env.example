# Copy to .env for local Docker Compose or configure these values in Dokploy.
# Use an alphanumeric/hex POSTGRES_PASSWORD because Compose builds DATABASE_URL.
# Example generator: openssl rand -hex 32
POSTGRES_DB=payroll
POSTGRES_USER=payroll
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

DEBUG=False
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=api.payroll.example.com
CSRF_TRUSTED_ORIGINS=https://api.payroll.example.com,https://payroll.example.com
CORS_ALLOWED_ORIGINS=https://payroll.example.com

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
MIGRATE_ON_START=True
MAX_UPLOAD_SIZE_MB=10
